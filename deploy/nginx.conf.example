# CYF 综合工作台 · nginx 部署示例
#
# 用法：
#   1. 把仓库内容放到 /var/www/cyf-workbench
#        sudo git clone https://github.com/qq1049323397/cyf-workbench.git /var/www/cyf-workbench
#   2. 把本文件拷到 /etc/nginx/sites-available/cyf-workbench，改掉 server_name 和证书路径
#        sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/cyf-workbench
#   3. 启用并重载
#        sudo ln -s /etc/nginx/sites-available/cyf-workbench /etc/nginx/sites-enabled/
#        sudo nginx -t && sudo systemctl reload nginx
#
# 证书可以用 certbot 免费签：
#   sudo certbot --nginx -d 你的域名

server {
    listen 80;
    listen [::]:80;
    server_name 你的域名;

    # 强制走 HTTPS。页面要调外部 AI 接口，明文 HTTP 下部分浏览器会拦。
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name 你的域名;

    # —— 证书（certbot 会自动填好这两行）——
    ssl_certificate     /etc/letsencrypt/live/你的域名/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/你的域名/privkey.pem;

    root  /var/www/cyf-workbench;
    index index.html;

    # 文件内部已声明 <meta charset="utf-8">，这里再声明一次更保险，避免中文乱码
    charset utf-8;

    # 整个网站就是 2.2MB 的一个 HTML，压缩后传输量降到约 1/5，强烈建议开
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/html text/css application/javascript application/json image/svg+xml;

    # 想更省流量可以上 brotli（需要 ngx_brotli 模块）：
    # brotli on;
    # brotli_types text/html text/css application/javascript application/json;

    # 单文件应用：任何路径都回到 index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # HTML 不缓存，改完刷新就能看到新版本；
    # 如果更在意速度，把下面这段换成较长的 max-age，并在更新后主动刷 CDN。
    location = /index.html {
        add_header Cache-Control "no-cache, must-revalidate";
        add_header X-Content-Type-Options "nosniff";
    }

    # 「试玩当前卡片」的运行时（可选，跑过 tools/install-runtime.sh 才有）
    location /RP-Hub-main/ {
        try_files $uri $uri/ /RP-Hub-main/index.html;
    }

    # 页面不采集任何数据，也没有后端，日志按需保留
    access_log /var/log/nginx/cyf-workbench.access.log;
    error_log  /var/log/nginx/cyf-workbench.error.log;
}
